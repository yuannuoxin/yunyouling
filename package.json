{
  "name": "yunyouling",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "山海经云游令 —— 神话主题（纯属虚构）营销页 1:1 复刻，Hono + React + Vite + Tailwind v4",
  "scripts": {
    "dev": "concurrently -n vite,hono -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "cf:dev": "wrangler dev",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "clsx": "^2.1.1",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.40.0"
  }
}
